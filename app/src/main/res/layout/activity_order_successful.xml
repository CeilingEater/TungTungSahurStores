<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pastel_yellow"
    tools:context=".OrderSuccessful">
    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/successAnimation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_fileName="Confetti.json"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/checkmarkAnimation"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="24dp"
                app:lottie_fileName="Success.json"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                android:visibility="invisible" />
            <TextView
                android:id="@+id/successTitle"
                android:text="@string/order_placed_successfully"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/successMessage"
                android:text="@string/thank_you_for_shopping_with_us"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/backToHomeButton"
                android:text="@string/back_to_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/peach"
                android:textColor="@color/red"/>
        </LinearLayout>
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>